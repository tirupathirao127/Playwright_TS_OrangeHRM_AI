# OrangeHRM Automation Framework - Environment Configuration Template
# Copy this file to .env.dev, .env.tst, .env.uat, .env.prd
# Do NOT commit actual credentials to version control

# Application Base URL
BASE_URL=https://opensource-demo.orangehrmlive.com

# OrangeHRM Credentials
# Use environment variables or GitHub Actions secrets in CI/CD
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# API Base URL
API_BASE_URL=https://opensource-demo.orangehrmlive.com/api/v1

# Browser Configuration
# Set to 'false' for headed (visible) browser execution
HEADLESS=true
